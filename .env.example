# Copy to .env (or set these in your host's dashboard). Never commit real values.

# Google "Sign in with Google" Web client ID (see README, section 2). Leave empty to disable Google login.
GOOGLE_CLIENT_ID=

# Long random string. Signs the hidden challenge codes. Keep it stable: changing it makes old codes unrecognisable.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MARKER_SECRET=

# Comma-separated Google emails allowed to open the hidden reviewer console (must be Google-verified emails).
ADMIN_EMAILS=

# Optional extra lock: comma-separated IPs the reviewer console may be used from. Empty = any IP.
ADMIN_IPS=

# Where the SQLite database lives (mount a persistent disk here in production).
DATA_DIR=./data

PORT=3000
NODE_ENV=production

# Set to 1 when the app sits behind a proxy/load balancer (Render, Fly, nginx...) so client IPs and HTTPS are detected.
TRUST_PROXY=1

# Local development only: lets you sign in without Google (ignored when NODE_ENV=production).
ALLOW_DEV_LOGIN=0
